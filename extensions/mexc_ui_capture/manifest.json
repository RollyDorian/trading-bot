{
  "manifest_version": 3,
  "name": "MEXC UI Market Observation Capture v1",
  "version": "1.0.0",
  "description": "Read-only capture of already-rendered MEXC futures market data. Does not trade.",
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "https://www.mexc.com/futures/*",
    "https://futures.mexc.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MEXC UI capture (read-only)"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.mexc.com/futures/*",
        "https://futures.mexc.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
